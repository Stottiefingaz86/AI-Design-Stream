{
  "name": "design-studio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vite-container.mjs",
    "dev": "node scripts/run-astro.mjs dev",
    "build": "node scripts/run-astro.mjs build",
    "preview": "node scripts/run-astro.mjs preview",
    "astro": "astro",
    "typecheck": "astro check",
    "predev": "node scripts/sync-tokens.mjs",
    "prebuild": "node scripts/sync-tokens.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:lint": "node scripts/lint-tokens.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "live-site:sync": "node scripts/sync-tokens.mjs && node scripts/sync-live-site-theme.mjs",
    "live-site:dev": "npm run live-site:sync && npm --prefix apps/live-site run dev"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.2",
    "@fontsource-variable/figtree": "^5.3.0",
