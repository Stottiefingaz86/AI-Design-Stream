    "@stepperize/react": "^8.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "astro": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "pixi.js": "^8.17.1",
    "postcss": "^8.5.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.2.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "storybook": "^10.6.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "7.3.1"
  }
