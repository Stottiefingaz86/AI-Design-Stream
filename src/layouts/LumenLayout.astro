---
/** Layout for prototype / component mocks: Lumen tokens only, no studio chrome. */
import '@/styles/lumen.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-brand="betonline">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <script is:inline src="/lumen-tip.js"></script>
    <slot />
  </body>
</html>
